# Supabase Configuration
# These environment variables are automatically set when you connect Supabase integration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Alternative names (for Next.js compatibility)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Redirect URL for development (optional)
# Used for OAuth callbacks during local development
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:5173/dashboard

# OpenAI API Key
# Required for AI-powered product analysis
# This key should also be added as a secret in Supabase Edge Functions
OPENAI_API_KEY=sk-your_openai_api_key

# ================================================================
# IMPORTANT: Supabase Edge Functions Secrets
# ================================================================
# To add OPENAI_API_KEY to your Supabase Edge Functions:
# 1. Go to your Supabase Dashboard > Settings > Edge Functions
# 2. Click "Manage Secrets"
# 3. Add a new secret with name: OPENAI_API_KEY
# 4. Paste your OpenAI API key as the value
# ================================================================
